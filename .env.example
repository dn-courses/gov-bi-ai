# Jupyter
JUPYTER_TOKEN=local-dev

# Postgres lab (defaults match labs/postgres/compose.yml)
POSTGRES_PASSWORD=postgres

# Claude Code needs nothing here: it signs in interactively inside the container, against your own
# subscription. See the Auth section of CLAUDE.md.

# OpenAI — used by the agent exercises, and REQUIRED (not optional) by the agents lab, whose compose
# file marks it mandatory and refuses to start without it. Never committed.
# Budget roughly 25 cents to execute every cell in that lab.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# BigQuery lab (cloud-dbs-sql lessons 04–05). Never commit a key.
# The shared GCP project you query:
# GOOGLE_CLOUD_PROJECT=my-gcp-project-id
# Auth option A (simplest): run `gcloud auth application-default login` in the workspace.
# Auth option B: a service-account key file reachable INSIDE the container (e.g. under /workspace):
# GOOGLE_APPLICATION_CREDENTIALS=/workspace/bigquery-sa-key.json
